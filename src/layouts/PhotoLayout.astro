---
import BaseLayout from "./BaseLayout.astro";
import RetroWindow from "../components/RetroWindow.astro";

const {
  title,
  description = "",
  date,
  doll = "",
  tags = [],
} = Astro.props;
---

<BaseLayout
  title={`${title}｜娃写真｜傑尼のBJD部屋`}
  description={description}
>
  <RetroWindow title="PHOTO_ALBUM.exe">
    <article class="photo-album">

      <header class="album-header">
        <h1>{title}</h1>

        <div class="album-info">
          {date && (
            <span>
              DATE：
              <time datetime={date.toISOString()}>
                {date.toLocaleDateString("zh-TW")}
              </time>
            </span>
          )}

          {doll && <span>DOLL：{doll}</span>}

          {tags.length > 0 && (
            <span>TAG：{tags.join(" / ")}</span>
          )}
        </div>
      </header>

      <hr />

      <div class="album-body">
        <slot />
      </div>

      <hr />

      <p class="back-link">
        <a href="/photos/">← 娃写真一覧へ戻る</a>
      </p>

    </article>
  </RetroWindow>
</BaseLayout>

<style>
  .album-header {
    margin-bottom: 18px;
  }

  .album-header h1 {
    margin: 0 0 8px;
  }

  .album-info {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 13px;
    font-family: monospace;
  }

  .album-body {
    line-height: 1.8;
  }

  /*
   * 写真頁的主角是圖。
   * 不裁切、不強迫統一比例。
   */
  .album-body :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 24px auto;
  }

  .album-body :global(p) {
    margin: 16px 0;
  }

  .album-body :global(h2) {
    margin-top: 32px;
  }

  .back-link {
    margin-bottom: 0;
    text-align: center;
  }
</style>