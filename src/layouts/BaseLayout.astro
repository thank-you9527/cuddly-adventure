---
import Navigation from "../components/Navigation.astro";
import "../styles/global.css";

const {
  title = "傑尼のBJD部屋",
  description = "BJD、娃照、教學與日常紀錄",
} = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <div class="site-shell">

      <header class="site-header">
        <h1>★ 傑尼のBJD部屋 ★</h1>
        <p>いらっしゃいませ！</p>
      </header>

      <nav class="site-nav">
        <a href="/">TOP</a>
        <a href="/photos">娃写真</a>
        <a href="/guides">BJD教學</a>
        <a href="/diary">日記</a>
        <a href="/links">LINK</a>
      </nav>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <hr />
        <p>管理人：傑尼</p>
        <p>Powered by 🦞</p>
      </footer>

    </div>
  </body>
</html>

