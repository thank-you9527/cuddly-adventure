---
import Sidebar from "../components/Sidebar.astro";
import HeaderRotator from "../components/HeaderRotator.astro";
import "../styles/global.css";

const {
  title = "傑尼のBJD部屋",
  description = "BJD、娃照、教學與日常紀錄",
} = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <div class="site-shell">

<header class="site-header">
  <div class="header-photo">
    <HeaderRotator side="left" />
  </div>

  <div class="header-title">
    <h1>★ 傑尼のBJD部屋 ★</h1>
    <p>いらっしゃいませ！</p>
  </div>

  <div class="header-photo">
    <HeaderRotator side="right" />
  </div>
</header>

<div class="page-columns">
  <Sidebar />

  <main class="main-content">
    <slot />
  </main>
</div>

      <footer class="site-footer">
        <hr />
        <p>管理人：傑尼</p>
        <p>Powered by 🦞</p>
      </footer>

    </div>
  </body>
</html>

