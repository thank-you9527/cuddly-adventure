---
const {
  title = "Untitled.txt",
  class: className = ""
} = Astro.props;
---

<section class={`retro-window ${className}`}>
  <div class="retro-titlebar">
    <span class="retro-title">{title}</span>

    <div class="retro-controls" aria-hidden="true">
      <button tabindex="-1">_</button>
      <button tabindex="-1">□</button>
      <button tabindex="-1">×</button>
    </div>
  </div>

  <div class="retro-content">
    <slot />
  </div>
</section>

<style>
  .retro-window {
    width: min(720px, calc(100vw - 24px));
    margin: 0 auto 24px;
    border: 2px solid var(--window-border);
    background: var(--window-bg);
    box-shadow: 4px 4px 0 var(--window-shadow);
    font-family: var(--font-main);
  }

   .retro-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 32px;
    padding-left: 10px;
    color: var(--titlebar-text);
    background: var(--titlebar-bg);
    border-bottom: 2px solid var(--window-border);
  }

  .retro-title {
    font-weight: bold;
  }

  .retro-controls {
    display: flex;
    align-self: stretch;
  }

  .retro-controls button {
    width: 30px;
    border: 0;
    border-left: 1px solid #111;
    background: #d9d9d9;
    font: inherit;
    font-weight: bold;
    cursor: default;
  }

  .retro-content {
    padding: 18px;
  }
</style>