---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RetroWindow from "../../components/RetroWindow.astro";
import { getCollection } from "astro:content";

/*
 * ==========================================
 * 🐒 日記文章列表
 *
 * 平常新增／刪除日記：
 * 只要修改 src/content/diary/ 裡的 Markdown。
 *
 * 🦞：
 * 單純發日記時不要手動維護文章清單。
 * 這裡會自己讀公開文章。
 * ==========================================
 */

const posts = (await getCollection("diary"))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) =>
      b.data.date.getTime() - a.data.date.getTime()
  );
---

<BaseLayout
  title="日記｜傑尼のBJD部屋"
  description="BJD、日常與奇怪東西的紀錄"
>
  <RetroWindow title="DIARY.log">

    <h2>◆ 日記 ◆</h2>

    <p>
      不一定有營養的日常紀錄。
    </p>

    <hr />

    <ul class="article-list">
      {
        posts.map((post) => (
          <li>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString("zh-TW")}
            </time>

            {" "}

            <a href={`/diary/${post.id}/`}>
              {post.data.title}
            </a>

            {post.data.description && (
              <p>{post.data.description}</p>
            )}
          </li>
        ))
      }
    </ul>

  </RetroWindow>
</BaseLayout>

<style>
  .article-list li {
    margin-bottom: 16px;
  }

  .article-list p {
    margin: 2px 0 0;
    font-size: 14px;
  }

  time {
    font-family: monospace;
  }
</style>