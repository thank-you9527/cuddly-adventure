---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RetroWindow from "../../components/RetroWindow.astro";
---

<BaseLayout
  title="LINK｜傑尼のBJD部屋"
  description="お気に入りサイト與奇怪的超連結"
>
  <RetroWindow title="LINK.html">
    <div class="links-page">
      <h2>★ おすすめ LINK ★</h2>

      <p>
        管理人のお気に入りサイトです。<br />
        リンクはご自由にどうぞ♪
      </p>

      <hr />

      <h3>◆ BJD / DOLL ◆</h3>

      <ul>
        <li>準備中...</li>
      </ul>

      <h3>◆ 素材 / TOOL ◆</h3>

      <ul>
        <li>準備中...</li>
      </ul>

      <h3>◆ お友達のHOME PAGE ◆</h3>

      <ul>
        <li>募集中＼(^o^)／</li>
      </ul>

      <hr />

      <p class="more">
        <a href="/links/squirtle_maze/">
          → もっとLINKを見る
        </a>
      </p>
    </div>
  </RetroWindow>
</BaseLayout>

<style>
  .links-page {
    line-height: 1.7;
  }

  .links-page h2 {
    text-align: center;
  }

  .links-page h3 {
    margin-top: 24px;
  }

  .more {
    margin-top: 30px;
    text-align: center;
    font-size: 12px;
  }
</style>