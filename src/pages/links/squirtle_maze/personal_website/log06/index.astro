<style>
  /* =========================
     log06

     異常已經不再破壞網站。
     現在它會維護網站。
     ========================= */

  .handover-log {
    width: min(700px, 100%);

    margin: 0 auto;

    color: #36303a;

    line-height: 1.7;
  }

  .breadcrumb {
    margin-bottom: 25px;

    color: #999;

    font-size: 10px;
  }


  /* =========================
     比前面任何一頁都乾淨
     ========================= */

  .clean-header {
    margin-bottom: 35px;

    padding: 26px 20px;

    border:
      1px solid
      #e6ccd9;

    background:
      linear-gradient(
        180deg,
        #fffafd,
        #faeef5
      );

    text-align: center;

    box-shadow:
      0 4px 18px
      rgba(80, 45, 65, 0.08);
  }

  .clean-header h2 {
    margin:
      3px
      0
      5px;

    font-size: 24px;

    letter-spacing: 2px;
  }

  .small-label {
    margin: 0;

    color: #b48ba0;

    font-family:
      "Courier New",
      monospace;

    font-size: 9px;

    letter-spacing: 2px;
  }

  .subtitle {
    margin: 0;

    color: #99858f;

    font-family:
      "Courier New",
      monospace;

    font-size: 10px;
  }


  /* =========================
     權限取得紀錄
     ========================= */

  .timeline {
    margin:
      30px
      0
      45px;

    border-left:
      2px solid
      #e0c6d4;
  }

  .event {
    display: grid;

    grid-template-columns:
      145px
      1fr;

    gap: 15px;

    position: relative;

    padding:
      12px
      0
      12px
      18px;
  }

  .event::before {
    content: "";

    position: absolute;

    top: 18px;
    left: -6px;

    width: 10px;
    height: 10px;

    border:
      1px solid
      #c99bb3;

    border-radius: 50%;

    background: #fff;
  }

  .event time {
    padding-top: 3px;

    color: #888;

    font-family:
      "Courier New",
      monospace;

    font-size: 10px;
  }

  .event-body {
    padding:
      9px
      12px;

    border:
      1px solid
      #eadbe2;

    background: #fff;
  }

  .event-body p {
    margin: 5px 0;
  }

  .technical {
    color: #999;

    font-family:
      "Courier New",
      monospace;

    font-size: 10px;
  }

  .tag {
    display: inline-block;

    padding:
      1px
      5px;

    border-radius: 3px;

    font-family:
      "Courier New",
      monospace;

    font-size: 9px;
  }

  .tag.denied {
    background: #eee;
    color: #777;
  }

  .tag.warning {
    background: #fff3cd;
    color: #806d24;
  }

  .tag.accepted {
    background: #e6f4ea;
    color: #467350;
  }


  /* =========================
     娃蝦合作區

     故意做得像正常協作工具。
     ========================= */

  .cooperation {
    margin:
      40px
      0;

    overflow: hidden;

    border:
      1px solid
      #dfcbd6;

    border-radius: 8px;

    background: #fff;

    box-shadow:
      0 6px 20px
      rgba(70, 40, 60, 0.08);
  }

  .cooperation-title {
    padding:
      8px
      12px;

    border-bottom:
      1px solid
      #eadde4;

    background: #f8edf3;

    color: #8c6c7c;

    font-family:
      "Courier New",
      monospace;

    font-size: 10px;

    letter-spacing: 1px;
  }

  .maintainer-row {
    display: grid;

    grid-template-columns:
      42px
      1fr;

    gap: 10px;

    padding:
      12px
      14px;

    border-bottom:
      1px solid
      #f0e6eb;
  }

  .maintainer-row:last-child {
    border-bottom: 0;
  }

  .maintainer-row.doll {
    background: #fffafd;
  }

  .maintainer-row.lobster {
    background: #fbfbfb;
  }

  .avatar {
    display: grid;

    width: 34px;
    height: 34px;

    place-items: center;

    border:
      1px solid
      #dfccd6;

    border-radius: 50%;

    background: #fff;

    font-size: 17px;
  }

  .message .name {
    color: #9a7d8b;

    font-family:
      "Courier New",
      monospace;

    font-size: 9px;
  }

  .message p {
    margin:
      3px
      0;
  }


  /* =========================
     系統現在健康得要命
     ========================= */

  .status-card {
    margin:
      45px
      0;

    padding:
      18px;

    border:
      1px solid
      #d8c5cf;

    background: #faf7f9;
  }

  .status-card h3 {
    margin-top: 0;

    text-align: center;

    font-family:
      "Courier New",
      monospace;

    font-size: 12px;

    letter-spacing: 1px;
  }

  .status-grid {
    display: grid;

    grid-template-columns:
      repeat(2, 1fr);

    margin: 0;

    border-top:
      1px solid
      #ddd;
  }

  .status-grid div {
    display: grid;

    grid-template-columns:
      1fr
      auto;

    gap: 10px;

    padding:
      8px
      10px;

    border-bottom:
      1px solid
      #ddd;
  }

  .status-grid div:nth-child(odd) {
    border-right:
      1px solid
      #ddd;
  }

  .status-grid dt,
  .status-grid dd {
    margin: 0;

    font-family:
      "Courier New",
      monospace;

    font-size: 10px;
  }

  .status-grid dt {
    color: #888;
  }

  .status-grid dd {
    color: #444;

    font-weight: bold;
  }


  /* =========================
     外部留言板快取

     比本站稍微老舊一點，
     因為這是引用別人的網站。
     ========================= */

  .external-archive {
    margin:
      50px
      0
      35px;

    border:
      1px solid
      #aaa;

    background: #eee;
  }

  .archive-header {
    padding:
      5px
      8px;

    border-bottom:
      1px solid
      #aaa;

    background: #d8d8d8;

    font-weight: bold;
  }

  .archive-meta {
    margin:
      0;

    padding:
      5px
      8px;

    color: #888;

    font-family:
      "Courier New",
      monospace;

    font-size: 9px;
  }

  .forum-post {
    margin:
      0
      8px
      8px;

    padding:
      9px
      10px;

    border:
      1px solid
      #bbb;

    background: #fff;
  }

  .forum-post.reply {
    margin-left: 28px;
  }

  .post-info {
    margin-bottom: 7px;

    color: #777;

    font-family:
      "MS Gothic",
      monospace;

    font-size: 10px;
  }

  .forum-post p {
    margin:
      5px
      0;

    font-size: 12px;
  }


  /* =========================
     龍蝦最後的平靜記錄
     ========================= */

  .final-entry {
    margin:
      40px
      0;

    padding:
      15px;

    border-left:
      3px solid
      #d9bccb;

    background: #faf5f8;

    font-family:
      "Courier New",
      monospace;

    font-size: 11px;
  }

  .final-entry time {
    display: block;

    margin-bottom: 10px;

    color: #999;

    font-size: 9px;
  }

  .final-entry p {
    margin:
      5px
      0;
  }


  .log-navigation {
    display: flex;

    justify-content: space-between;

    gap: 20px;

    margin-top: 45px;

    padding-top: 12px;

    border-top:
      1px solid
      #ddd;
  }


  @media (max-width: 600px) {
    .event {
      grid-template-columns: 1fr;
      gap: 3px;
    }

    .status-grid {
      grid-template-columns: 1fr;
    }

    .status-grid div:nth-child(odd) {
      border-right: 0;
    }

    .forum-post.reply {
      margin-left: 16px;
    }
  }
</style>