<script>
  /*
   * 圖片還沒做好時顯示古早缺圖框。
   */
  const photo = document.querySelector(".parts-photo img");
  const missing = document.querySelector(".missing-photo");

  if (photo instanceof HTMLImageElement) {
    photo.addEventListener("load", () => {
      if (missing instanceof HTMLElement) {
        missing.hidden = true;
      }
    });

    photo.addEventListener("error", () => {
      photo.hidden = true;

      if (missing instanceof HTMLElement) {
        missing.hidden = false;
      }
    });
  }
</script>


<style>
  /*
   * 整頁故意超出正常內容框。
   * 中間仍然保持可讀。
   */
  .infected-page {
    display: grid;

    grid-template-columns:
      135px
      minmax(0, 1fr)
      135px;

    gap: 8px;

    align-items: start;
  }

  .real-content {
    min-width: 0;

    padding: 8px;

    line-height: 1.7;
  }

  .real-content h2 {
    text-align: center;
  }

  .breadcrumb {
    color: #666;

    font-size: 11px;
  }


  /* ==============================
     BJD 圖片
     ============================== */

  .parts-photo {
    display: grid;

    width: min(520px, 95%);
    min-height: 260px;

    margin: 24px auto;

    border: 3px ridge #bbb;

    place-items: center;

    background: #ccc;
  }

  .parts-photo img {
    display: block;

    width: 100%;
    height: auto;
  }

  .missing-photo {
    padding: 80px 10px;

    color: #555;

    font-family: monospace;
    font-size: 12px;

    text-align: center;
  }


  /* ==============================
     打錯註解所以全部露出來
     ============================== */

  .broken-comment {
    margin: 45px 0 25px;

    padding: 7px 10px;

    border-left: 2px solid #aaa;

    color: #777;

    font-family:
      "Courier New",
      monospace;

    font-size: 11px;
  }

  .broken-comment p {
    margin: 5px 0;
  }

  .update {
    margin-top: 35px;

    color: #888;

    font-size: 10px;

    text-align: right;
  }


  /* ==============================
     ✨ 精神污染區 ✨
     ============================== */

  .ad-rail {
    display: flex;

    flex-direction: column;

    gap: 7px;
  }

  .trash-ad {
    display: flex;

    min-height: 90px;

    padding: 5px 2px;

    border:
      3px
      outset
      #ddd;

    align-items: center;
    justify-content: center;
    flex-direction: column;

    overflow: hidden;

    text-align: center;

    font-family:
      Arial,
      sans-serif;

    font-size: 11px;

    font-weight: bold;

    text-decoration: underline;

    animation:
      ad-colors
      0.55s
      steps(1)
      infinite;
  }

  .trash-ad .huge {
    font-size: 16px;
  }

  /*
   * 每個廣告故意不同步，
   * 避免整齊得像現代網站。
   */

  .neon-b {
    animation-delay: -0.21s;
  }

  .neon-c {
    animation-delay: -0.37s;
  }

  .neon-d {
    animation-delay: -0.13s;
  }

  @keyframes ad-colors {
    0% {
      background: #ffff00;
      color: #ff0000;
    }

    25% {
      background: #ff00ff;
      color: #00ff00;
    }

    50% {
      background: #00ffff;
      color: #0000ff;
    }

    75% {
      background: #000000;
      color: #ffff00;
    }
  }


  /*
   * GIF 還沒生之前先留坑。
   */

  .gif-hole {
    display: grid;

    min-height: 60px;

    border: 2px dashed #ff00ff;

    place-items: center;

    background: #000;

    color: #00ff00;

    font-family:
      "Courier New",
      monospace;

    font-size: 11px;

    text-align: center;

    animation:
      gif-hole-blink
      0.8s
      steps(1)
      infinite;
  }

  @keyframes gif-hole-blink {
    50% {
      color: #ff00ff;
      background: #ffff00;
    }
  }


  /*
   * 手機上左右兩條垃圾不要把正文壓死。
   *
   * 改成：
   * 左垃圾
   * 正文
   * 右垃圾
   */

  @media (max-width: 800px) {
    .infected-page {
      display: flex;

      flex-direction: column;
    }

    .real-content {
      order: 1;
    }

    .ad-left {
      order: 2;
    }

    .ad-right {
      order: 3;
    }

    .ad-rail {
      display: grid;

      width: 100%;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }


  /*
   * 如果訪客要求減少動畫，
   * 精神污染還在，但不要真的把人眼睛炸掉。
   */

  @media (prefers-reduced-motion: reduce) {
    .trash-ad,
    .gif-hole {
      animation: none;
    }
  }
</style>