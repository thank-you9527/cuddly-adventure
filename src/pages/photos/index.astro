---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RetroWindow from "../../components/RetroWindow.astro";
import { getCollection } from "astro:content";

const albums = (await getCollection("photos"))
  .filter((album) => !album.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="娃写真｜傑尼のBJD部屋"
  description="BJD娃写真與攝影紀錄"
>
  <RetroWindow title="PHOTO_GALLERY.exe">

    <div class="gallery-header">
      <h2>◆ 娃写真 ◆</h2>
      <p>人形写真、撮影紀錄與一些不知道在幹嘛的東西。</p>
    </div>

    <hr />

    {
      albums.length > 0 ? (
        <div class="photo-grid">
          {albums.map((album) => (
            <a
              class="photo-card"
              href={`/photos/${album.id}/`}
            >
              <div class="photo-thumb">
                {album.data.cover ? (
                  <img
                    src={album.data.cover}
                    alt={`${album.data.title} 封面`}
                    loading="lazy"
                  />
                ) : (
                  <div class="no-image">
                    NO IMAGE
                  </div>
                )}
              </div>

              <div class="photo-info">
                <strong>{album.data.title}</strong>

                <time datetime={album.data.date.toISOString()}>
                  {album.data.date.toLocaleDateString("zh-TW")}
                </time>

                {album.data.doll && (
                  <span>{album.data.doll}</span>
                )}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty">
          写真はまだありません(´・ω・`)
        </p>
      )
    }

  </RetroWindow>
</BaseLayout>

<style>
  .gallery-header h2 {
    margin-bottom: 6px;
  }

  .gallery-header p {
    margin-top: 0;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 18px;
  }

  .photo-card {
    display: block;
    padding: 5px;
    border: 1px solid #333;
    background: #eeeeee;
    color: inherit;
    text-decoration: none;
  }

  .photo-card:hover {
    outline: 2px dotted #ff69b4;
  }

  .photo-thumb {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px inset #aaa;
    background: #ddd;
  }

  .photo-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .no-image {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-family: monospace;
    font-size: 12px;
  }

  .photo-info {
    padding: 7px 3px 3px;
  }

  .photo-info strong,
  .photo-info time,
  .photo-info span {
    display: block;
  }

  .photo-info time,
  .photo-info span {
    margin-top: 3px;
    font-family: monospace;
    font-size: 12px;
  }

  .empty {
    padding: 30px 0;
    text-align: center;
  }

  @media (max-width: 900px) {
    .photo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .photo-grid {
      grid-template-columns: 1fr;
    }
  }
</style>